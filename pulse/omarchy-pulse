VERSION = "1.0.0"
HOME = Path.home()
CONF_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "omarchy-pulse"
CONF = CONF_DIR / "pulse.toml"
TOKEN_FILE = CONF_DIR / "token"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omarchy-pulse"
OMARCHY_CURRENT = HOME / ".local/state/omarchy/current"   # where Omarchy 4.5 puts the applied theme and background
