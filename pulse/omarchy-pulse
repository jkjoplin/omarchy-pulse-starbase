# ---------------------------------------------------------------- CLI

def port_of(cfg: dict | None = None) -> int:
    cfg = cfg if cfg is not None else load_config()
    return int(os.environ.get("PULSE_PORT") or (cfg.get("pulse") or {}).get("port") or DEFAULT_PORT)


def client(method: str, path: str, body: bytes = b"", ctype: str = "text/plain") -> dict:
    port = port_of()
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=body if method == "POST" else None,
                                 method=method, headers={"X-Pulse-Token": token(), "Content-Type": ctype})
    with urllib.request.urlopen(req, timeout=5) as r:
        return json.loads(r.read() or b"{}")


def main(argv: list[str]) -> int:
    cmd = argv[1] if len(argv) > 1 else "help"
    if cmd in ("run", "serve"):
        demo = "--demo" in argv
        hub = Hub(demo=demo)
        port = port_of()
        try:
            serve(hub, port)
        except OSError as e:
            log(f"port {port} busy ({e}): is Pulse already running? (systemctl --user status omarchy-pulse)")
            return 1
        hub.start()
        url = f"http://127.0.0.1:{port}/?token={token()}"
        log(f"Omarchy Pulse {VERSION} on http://127.0.0.1:{port}/" + (" (demo data)" if demo else ""))
        if cmd == "serve":
            print(url, flush=True)
            try:
                while True:
                    time.sleep(3600)
            except KeyboardInterrupt:
                return 0
        return run_wall(url, str(hub.conf("pulse", "gpu", default="auto")))
    if cmd == "push":
        if len(argv) < 4:
            print("usage: omarchy-pulse push NAME VALUE|- [--title T] [--type T] [--level L] [--slot S]")
            return 2
        name, value = argv[2], argv[3]
        opts = {}
        rest = argv[4:]
        for i, a in enumerate(rest):
            if a.startswith("--") and i + 1 < len(rest):
                opts[a[2:]] = rest[i + 1]
        if value == "-":
            body = sys.stdin.buffer.read()
        elif Path(value).is_file() and Path(value).suffix.lower() in (".jpg", ".jpeg", ".png", ".webp"):
            body = Path(value).read_bytes()
            opts.setdefault("_img", Path(value).suffix.lower().lstrip(".").replace("jpg", "jpeg"))
        else:
            body = value.encode()
        img = opts.pop("_img", None)
        qs = urllib.parse.urlencode(opts)
        try:
            client("POST", f"/api/push/{urllib.parse.quote(name)}?{qs}", body, f"image/{img}" if img else "text/plain")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        return 0
    if cmd == "privacy":
        v = argv[2] if len(argv) > 2 else "toggle"
        try:
            print("privacy:", "on" if client("POST", "/api/privacy", v.encode())["privacy"] else "off")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        return 0
    if cmd == "reload":
        try:
            client("POST", "/api/reload")
            print("reloaded")
        except Exception as e:   # noqa: BLE001
            print(f"omarchy-pulse is not running? ({e})", file=sys.stderr)
            return 1
        return 0
    if cmd == "doctor":
        ok = True
        print(f"Omarchy Pulse {VERSION}")
        for mod, pkg in (("Gtk 3.0", "gtk3"), ("GtkLayerShell 0.1", "gtk-layer-shell"), ("WebKit2 4.1", "webkit2gtk-4.1")):
            r = subprocess.run([sys.executable, "-c", f"import gi; gi.require_version('{mod.split()[0]}', '{mod.split()[1]}');"
                                f"from gi.repository import {mod.split()[0]}"], capture_output=True)
            print(("  ok   " if r.returncode == 0 else "  MISS ") + f"{mod:20} ({pkg})")
            ok &= r.returncode == 0
        for tool, why in (("ffmpeg", "cameras"), ("playerctl", "now playing"), ("gh", "GitHub notifications"),
                          ("makoctl", "notifications"), ("hyprctl", "calm down under windows, privacy")):
            print(("  ok   " if shutil.which(tool) else "  --   ") + f"{tool:20} ({why})")
        cfg = load_config()
        if cfg.get("_error"):
            print("  ERR  pulse.toml: " + cfg["_error"])
            ok = False
        else:
            print(f"  ok   {CONF} ({len(cfg.get('source', []))} sources)")
        print(f"  theme: {theme_name() or '?'}")
        return 0 if ok else 1
    print(__doc__)
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
