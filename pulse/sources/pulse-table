#!/usr/bin/env python3
"""Omarchy Pulse helper: tab- (or 2+ space-) separated lines on stdin -> a two-column table panel.
   docker ps --format '{{.Names}}\t{{.Status}}' | pulse-table
(c) 2026 Marco Porro (x.com/MarcoPorro), MIT"""
import json, re, sys
rows = []
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line.strip():
        continue
    parts = line.split("\t") if "\t" in line else re.split(r"\s{2,}", line.strip(), maxsplit=1)
    rows.append([parts[0], parts[1] if len(parts) > 1 else ""])
print(json.dumps({"rows": rows[:30]}))
